rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------- Users -----------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ----------------- Rides (Trips) -----------------
    match /rides/{rideId} {
      // Allow read for everyone to see available trips on the home page
      allow read: if true;

      // Authenticated users can create rides
      allow create: if request.auth != null;
      
      // Update rules:
      // Drivers can update their own rides.
      // Passengers can update the 'bookedBy' array to join/leave.
      allow update: if request.auth != null && (
        resource.data.carOwnerId == request.auth.uid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['bookedBy'])
      );
      
      // Only car owner can delete their ride
      allow delete: if request.auth != null && resource.data.carOwnerId == request.auth.uid;
    }

    // ----------------- Bookings -----------------
    match /bookings/{bookingId} {
      // Authenticated users can read bookings
      allow read: if request.auth != null;
      
      // Authenticated users can create bookings
      allow create: if request.auth != null;
      
      // Update rules:
      // Allow updates by the passenger or the driver of the trip
      allow update: if request.auth != null;
      
      // Delete rules:
      // Allow deletion by the passenger or the driver
      allow delete: if request.auth != null;
    }

    // ----------------- Admin App Settings -----------------
    match /app_settings/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ----------------- Deny everything else -----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

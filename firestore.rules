rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // RIDES (legacy)  /rides/{rideId}
    // Fields expected:
    // carOwnerId, bookedBy[], origin, destination, time
    // =============================
    match /rides/{rideId} {

      // ✅ Any signed-in user can read
      allow read: if request.auth != null;

      // ✅ Ride creation: only car owner can create
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'carOwnerId','bookedBy','origin','destination','time'
        ])
        && request.resource.data.carOwnerId == request.auth.uid
        && request.resource.data.bookedBy is list;

      // Updates:
      // - owner can update anything
      // - passenger can only modify bookedBy (join/leave)
      allow update: if request.auth != null && (
        resource.data.carOwnerId == request.auth.uid ||

        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['bookedBy']) &&

          (
            // join
            (!resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.bookedBy.hasAny([request.auth.uid])) ||

            // leave
            (resource.data.bookedBy.hasAny([request.auth.uid]) &&
              !request.resource.data.bookedBy.hasAny([request.auth.uid]))
          )
        )
      );

      // Only owner deletes
      allow delete: if request.auth != null && resource.data.carOwnerId == request.auth.uid;
    }


    // =============================
    // TRIPS (current app) /trips/{tripId}
    // Fields expected (minimum):
    // driver_id, bookedBy[], seats_available, seats_booked
    // (You can store extra fields like route, price_per_seat, car_make, car_model etc.)
    // =============================
    match /trips/{tripId} {

      // Any signed-in user can read trips
      allow read: if request.auth != null;

      // Driver creates trip
      allow create: if request.auth != null
        && request.resource.data.driver_id == request.auth.uid
        && request.resource.data.bookedBy is list
        && request.resource.data.seats_available is int
        && request.resource.data.seats_booked is int
        && request.resource.data.seats_available >= 1
        && request.resource.data.seats_booked >= 0
        && request.resource.data.seats_booked <= request.resource.data.seats_available;

      // Updates:
      // - driver can update anything
      // - passenger can ONLY book (bookedBy + seats_booked) OR cancel (bookedBy + seats_booked)
      allow update: if request.auth != null && (
        // driver full control
        resource.data.driver_id == request.auth.uid ||

        (
          // passenger limited keys only
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['bookedBy','seats_booked']) &&

          (
            // BOOK: uid added + seats_booked +1
            (
              !resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.seats_booked == resource.data.seats_booked + 1 &&
              request.resource.data.seats_booked <= resource.data.seats_available
            )
            ||
            // CANCEL: uid removed + seats_booked -1
            (
              resource.data.bookedBy.hasAny([request.auth.uid]) &&
              !request.resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.seats_booked == resource.data.seats_booked - 1 &&
              request.resource.data.seats_booked >= 0
            )
          )
        )
      );

      // Only driver deletes
      allow delete: if request.auth != null && resource.data.driver_id == request.auth.uid;
    }

    // =============================
    // BOOKINGS (Request & Accept workflow)
    // =============================
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.passenger_id == request.auth.uid || 
        get(/databases/$(database)/documents/rides/$(resource.data.trip_id)).data.carOwnerId == request.auth.uid
      );
    }

    // =============================
    // USERS /users/{userId}
    // =============================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // =============================
    // APP SETTINGS /app_settings/{documentId}
    // =============================
    match /app_settings/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    // =============================
    // DENY EVERYTHING ELSE
    // =============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

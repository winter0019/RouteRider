rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------- Rides -----------------
    match /rides/{rideId} {

      // ✅ Any signed-in user can read rides
      allow read: if request.auth != null;

      // ✅ Ride creation: only car owner can create
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'carOwnerId','bookedBy','origin','destination','time'
                    ])
                    && request.resource.data.carOwnerId == request.auth.uid
                    && request.resource.data.bookedBy is list;

      // ✅ Ride updates
      allow update: if request.auth != null && (
        
        // Car owner can update anything
        resource.data.carOwnerId == request.auth.uid ||

        // Passenger can only update "bookedBy"
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['bookedBy']) &&

          (
            // Booking: user joins the list
            (!resource.data.bookedBy.hasAny([request.auth.uid]) &&
             request.resource.data.bookedBy.hasAny([request.auth.uid])) ||

            // Cancellation: user leaves the list
            (resource.data.bookedBy.hasAny([request.auth.uid]) &&
             !request.resource.data.bookedBy.hasAny([request.auth.uid]))
          )
        )
      );

      // ✅ Only car owner can delete ride
      allow delete: if request.auth != null && resource.data.carOwnerId == request.auth.uid;
    }

    // ----------------- Users -----------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ----------------- Bookings -----------------
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.passenger_id == request.auth.uid || get(/databases/$(database)/documents/rides/$(resource.data.trip_id)).data.carOwnerId == request.auth.uid);
    }

    // ----------------- Admin App Settings -----------------
    match /app_settings/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    // ----------------- Deny everything else -----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

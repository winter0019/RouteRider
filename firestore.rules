rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // =============================
    // RIDES /rides/{rideId}
    // =============================
    match /rides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.carOwnerId == request.auth.uid
        && request.resource.data.bookedBy is list
        && request.resource.data.seats_available is int
        && request.resource.data.seats_booked is int
        && request.resource.data.seats_available >= 1
        && request.resource.data.seats_booked == 0;

      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.carOwnerId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['bookedBy', 'seats_booked']) &&
          (
            (
              !resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.seats_booked == resource.data.seats_booked + 1 &&
              request.resource.data.seats_booked <= resource.data.seats_available
            )
            ||
            (
              resource.data.bookedBy.hasAny([request.auth.uid]) &&
              !request.resource.data.bookedBy.hasAny([request.auth.uid]) &&
              request.resource.data.seats_booked == resource.data.seats_booked - 1 &&
              request.resource.data.seats_booked >= 0
            )
          )
        )
      ));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.carOwnerId == request.auth.uid);
    }

    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driver_id == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.driver_id == request.auth.uid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['bookedBy','seats_booked'])
      ));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.driver_id == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.passenger_id || 
        request.auth.uid == resource.data.driver_id
      ));
      allow create: if isSignedIn() && request.resource.data.passenger_id == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.passenger_id || 
        request.auth.uid == resource.data.driver_id
      ));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.balanceKobo == 0;
      allow update, delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.uid == request.auth.uid || 
        resource.data.user_id == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.type in ["topup","withdrawal_request"];
      allow update, delete: if false;
    }

    match /kyc_submissions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.status == "submitted";
      allow update: if isOwner(uid)
        && resource.data.status in ["none","submitted","rejected"]
        && request.resource.data.status == "submitted";
      allow delete: if isAdmin();
    }

    match /escrows/{escrowId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /app_settings/{documentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
